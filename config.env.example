# Copy to config.env (never committed) and fill in YOUR OWN keys.
# prepare.sh turns this into tvos/Generated/nv_config.h.
#
# Account sync and the TV login QR need a Supabase backend compatible with the
# Nuvio one. Leave empty to build without account features.
NV_SUPABASE_URL=
NV_SUPABASE_ANON_KEY=
NV_TV_LOGIN_BASE=
#
# Your own app registrations (https://trakt.tv/oauth/applications,
# https://simkl.com/settings/developer, https://www.themoviedb.org/settings/api)
NV_TRAKT_CLIENT_ID=
NV_TRAKT_CLIENT_SECRET=
NV_SIMKL_CLIENT_ID=
NV_SIMKL_APP=
NV_TMDB_API_KEY=
#
# Optional
NV_SEEKR_API_KEY=
NV_REC_URL=
NV_DISCORD_CLIENT_ID=
