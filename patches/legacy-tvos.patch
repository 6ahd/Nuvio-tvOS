+#elif defined(NV_TVOS)
+// --------------------------------------------------------------- Apple TV --
+//
+// No tvOS nao ha libwebp para o dlopen (o app e assinado; nada de fora entra)
+// e o SDL_image foi compilado sem WebP: todo cartaz/fundo .webp (Trakt,
+// Xperience, addons de poster, selos) virava cartao vazio. O ImageIO do
+// sistema le WebP desde o tvOS 14, inclusive o animado (indice 0 = primeiro
+// quadro). A reducao a `largMax` sai do proprio decoder (miniatura com
+// tamanho maximo), entao o RGBA cheio de um fundo 3840x2160 nunca existe.
+#include <CoreFoundation/CoreFoundation.h>
+#include <CoreGraphics/CoreGraphics.h>
+#include <ImageIO/ImageIO.h>
+
+static uint8_t *decodificar(const unsigned char *dados, size_t n, int largMax,
+                            int *lw, int *lh, int *ow, int *oh) {
+  CFDataRef d;
+  CGImageSourceRef src;
+  CGImageRef img = NULL;
+  CFDictionaryRef props;
+  CGColorSpaceRef cs;
+  CGContextRef ctx;
+  uint8_t *px = NULL;
+  int w = 0, h = 0, sw, sh;
+  d = CFDataCreateWithBytesNoCopy(NULL, dados, (CFIndex)n, kCFAllocatorNull);
+  if (!d) return NULL;
+  src = CGImageSourceCreateWithData(d, NULL);
+  CFRelease(d);
+  if (!src) return NULL;
+  props = CGImageSourceCopyPropertiesAtIndex(src, 0, NULL);
+  if (props) {
+    CFNumberRef nw = CFDictionaryGetValue(props, kCGImagePropertyPixelWidth);
+    CFNumberRef nh = CFDictionaryGetValue(props, kCGImagePropertyPixelHeight);
+    if (nw) CFNumberGetValue(nw, kCFNumberIntType, &w);
+    if (nh) CFNumberGetValue(nh, kCFNumberIntType, &h);
+    CFRelease(props);
+  }
+  if (w < 1 || h < 1 || (long)w * h > 8192L * 8192L) { CFRelease(src); return NULL; }
+  if (ow) *ow = w;
+  if (oh) *oh = h;
+  if (largMax > 0 && w > largMax) {
+    int lado = (int)(((long)(w > h ? w : h) * largMax + w - 1) / w);
+    CFNumberRef num = CFNumberCreate(NULL, kCFNumberIntType, &lado);
+    const void *k[] = { kCGImageSourceCreateThumbnailFromImageAlways,
+                        kCGImageSourceThumbnailMaxPixelSize,
+                        kCGImageSourceCreateThumbnailWithTransform };
+    const void *v[] = { kCFBooleanTrue, num, kCFBooleanFalse };
+    CFDictionaryRef o = CFDictionaryCreate(NULL, k, v, 3, &kCFTypeDictionaryKeyCallBacks,
+                                           &kCFTypeDictionaryValueCallBacks);
+    img = CGImageSourceCreateThumbnailAtIndex(src, 0, o);
+    CFRelease(o);
+    CFRelease(num);
+  }
+  if (!img) img = CGImageSourceCreateImageAtIndex(src, 0, NULL);
+  CFRelease(src);
+  if (!img) return NULL;
+  sw = (int)CGImageGetWidth(img);
+  sh = (int)CGImageGetHeight(img);
+  if (sw < 1 || sh < 1) { CGImageRelease(img); return NULL; }
+  px = calloc((size_t)sw * sh, 4);
+  cs = CGColorSpaceCreateDeviceRGB();
+  // Bytes R,G,B,A na memoria. O CGBitmapContext so aceita RGBA de 8 bits com
+  // alfa pre-multiplicado; a divisao abaixo devolve o alfa reto que o SDL usa.
+  ctx = px && cs ? CGBitmapContextCreate(px, (size_t)sw, (size_t)sh, 8, (size_t)sw * 4, cs,
+                                         kCGImageAlphaPremultipliedLast | kCGBitmapByteOrder32Big)
+                 : NULL;
+  if (cs) CGColorSpaceRelease(cs);
+  if (!ctx) { free(px); CGImageRelease(img); return NULL; }
+  CGContextSetBlendMode(ctx, kCGBlendModeCopy);
+  CGContextDrawImage(ctx, CGRectMake(0, 0, sw, sh), img);
+  CGContextRelease(ctx);
+  CGImageRelease(img);
+  { size_t i, tot = (size_t)sw * sh * 4;
+    for (i = 0; i < tot; i += 4) {
+      unsigned a = px[i + 3];
+      if (a && a < 255) {
+        unsigned r = (px[i] * 255u + a / 2) / a, g = (px[i + 1] * 255u + a / 2) / a,
+                 b = (px[i + 2] * 255u + a / 2) / a;
+        px[i] = (uint8_t)(r > 255 ? 255 : r);
+        px[i + 1] = (uint8_t)(g > 255 ? 255 : g);
+        px[i + 2] = (uint8_t)(b > 255 ? 255 : b);
+      }
+    } }
+  *lw = sw; *lh = sh;
+  return px;
+}
+
+static void soltar(uint8_t *px) { free(px); }
+
 #else
